#!/usr/bin/env bash
# =============================================================================
# classroom.sh — Classroom Device Connection Utility
# =============================================================================
#
# DESCRIPTION:
#   Wraps the EMS availability check, SmartClassroom VLAN device lookup, and
#   Crestron device connection into a single command. Typical usage:
#
#     1. Checks EMS to see if the target room is currently in use.
#     2. Looks up AV devices for that room (HDPS, PANEL, DMPS, etc.) in the
#        local SmartClassroom VLAN export file.
#     3. Prompts you to select a device if multiple are found, then hands off
#        to connect.sh.
#
# USAGE:
#   classroom.sh [-v|--verbose] [-h|--help] [--no-ems] [--require-free]
#                [--refresh] [--info] [--diag] [--log] [--device <type>]
#                [--method <method>] <room_code> [-- <command> [args...]]
#
#   <room_code>
#       Room code to connect to (e.g. "FH0111", "AH1301"). Case-insensitive.
#       Matched against device hostnames in the SmartClassroom export.
#
#   -v, --verbose
#       Show verbose output; passed through to ems.sh and connect.sh.
#
#   -h, --help
#       Print this usage summary and exit.
#
#   --no-ems
#       Skip the EMS availability check entirely.
#
#   --require-free
#       Refuse to connect or send a command if EMS reports the room as
#       currently booked (dies instead of the default "proceeding anyway").
#       Does not affect --info/--diag, which are read-only and always run.
#       If the EMS check itself errors or is inconclusive, this still allows
#       the connection (same fallback as the default behavior) — it only
#       blocks on a confirmed BOOKED result. Mutually exclusive with --no-ems.
#
#   --refresh
#       Force-refresh the SmartClassroom export before searching by running
#       'efficient vlan show SmartClassroom --no-pager'. Requires efficient
#       to be in PATH.
#
#   --info
#       Print the room's devices and their reachability, then exit without
#       connecting. A read-only triage view.
#
#   --diag
#       Like --info, plus: runs DIAG_CMD over SSH on devices matching
#       DIAG_SSH_TYPES (default: panel/DMPS/HDPS). If the room has an HDPS
#       device, also runs a VC-4 status lookup (room_status.sh) and an
#       HD-PS signal/routing/mute status snapshot (hdps_status.sh) — both
#       are skipped for rooms without one, since neither applies. Read-only;
#       exits without connecting.
#
#   --log
#       Open the activity log (LOG_FILE) in $VISUAL/$EDITOR (falls back to vi)
#       and exit. No room code required.
#
#   --device <type>
#       Auto-select the device whose type matches <type> (case-insensitive;
#       e.g. "dmps", "panel", "hdps"), skipping the interactive prompt. Matches
#       the device type exactly first, then by prefix. If the match is ambiguous
#       the selection menu is shown; if nothing matches, all devices are shown.
#
#   --method <admin|crestron|telnet>
#       Passed through to connect.sh — skip the cascade and use only this
#       connection method.
#
#   -- <command> [args...]
#       Passed through to connect.sh — run a command instead of an
#       interactive session.
#
# EXAMPLES:
#   classroom.sh FH0111                  # Check EMS, find devices, connect
#   classroom.sh --no-ems AH1301         # Skip EMS check
#   classroom.sh --require-free FH0111   # Abort if EMS says the room is booked
#   classroom.sh --refresh FH0111        # Refresh export, then connect
#   classroom.sh --info FH0111           # Show devices + reachability, no connect
#   classroom.sh --diag FH0111           # Reachability + iptable + VC-4 status, no connect
#   classroom.sh --device dmps FH0111    # Skip the prompt, connect to the DMPS
#   classroom.sh FH0111 -- ver           # Run 'ver' on the selected device
#   classroom.sh --method telnet PH0302  # Force telnet connection
#
# DEPENDENCIES:
#   All co-located helper scripts below resolve via either their "<name>.sh"
#   form or an extensionless "<name>" (e.g. as symlinked into ~/bin) — see
#   resolve_script().
#   ems.sh         — Co-located in the same directory as this script.
#   connect.sh     — Co-located in the same directory as this script.
#   efficient      — Only required when --refresh is used. Must be in PATH.
#                    Run: efficient vlan show SmartClassroom --no-pager
#   panelviewer    — Optional. Must be in PATH. When present, offered as an
#                    alternative to SSH for PANEL/TSW750 devices.
#   room_status.sh — Co-located in the same directory. Used by --diag for the
#                    VC-4 status lookup. Requires curl and jq; reads
#                    crestron/vc4/host, work/username, and work/password from
#                    pass when not overridden.
#   hdps_status.sh — Co-located in the same directory. Used by --diag for the
#                    HD-PS routing/signal/mute status snapshot. Requires curl
#                    and jq; reads crestron/creds/username and
#                    crestron/creds/password from pass when not overridden.
#
# CONFIGURATION:
#   Settings are read from a sourced shell config file (KEY="value" lines):
#     ${XDG_CONFIG_HOME:-~/.config}/classroom/config
#   Override the location with CLASSROOM_CONFIG=/path/to/config. On first run
#   a commented template listing every key and its default is written there.
#   Recognized keys (all optional; built-in defaults shown):
#     EXPORT_PATH       Path to the SmartClassroom export (~/work/SmartClassroom)
#     VLAN_NAME         VLAN name passed to 'efficient vlan show' (SmartClassroom)
#     STALE_DAYS        Age in days before the export is warned as stale (1)
#     SSH_PORT          Port probed for SSH reachability (22)
#     TELNET_PORT       Port probed for Crestron console reachability (41795)
#     PROBE_TIMEOUT     Per-probe timeout in seconds for TCP/ICMP checks (1)
#     PANEL_LABELS      Space-separated device labels offered PanelViewer (PANEL TSW750)
#     PROJECTOR_PREFIX  Label prefix treated as a web-only projector (PROJ)
#     DIAG_SSH_TYPES    Device label prefixes --diag runs DIAG_CMD against (PANEL TSW750 HDPS DMPS)
#     DIAG_CMD          Command run on each matched device by --diag (iptable -T)
#     DIAG_TIMEOUT      Per-device timeout in seconds for DIAG_CMD (15)
#     VC4_TIMEOUT       Timeout in seconds for the --diag VC-4 status lookup (35)
#     HDPS_TIMEOUT      Timeout in seconds for the --diag HD-PS status snapshot (20)
#     LOG_FILE          Path to the activity log (see LOGGING)
#
# LOGGING:
#   Each EMS check, device lookup, export refresh, --diag run, and connection
#   handoff is appended as a timestamped line to LOG_FILE, which defaults to
#     ${XDG_STATE_HOME:-~/.local/state}/classroom/classroom.log
#   Logging is best-effort: a failure to write never aborts the run.
#
# SMART CLASSROOM EXPORT:
#   Stored as a single file (EXPORT_PATH, default ~/work/SmartClassroom) with an
#   embedded "# Exported: YYYY-MM-DD" header written by --refresh. To refresh:
#     classroom.sh --refresh
#   Or manually (no age-tracking header):
#     efficient vlan show SmartClassroom --no-pager > ~/work/SmartClassroom
#
# EXIT CODES:
#   Propagates connect.sh exit codes via exec:
#   0   Session established and ended cleanly.
#   1   Connection failed or user aborted.
#   64  Usage error.
#   69  Missing required dependency.
#   77  Credential retrieval failure.
#
# =============================================================================

set -euo pipefail

readonly VERSION="1.4"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- COLORS (disabled when stderr is not a TTY) ---
if [[ -t 2 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' NC=''
fi

vecho() { $VERBOSE && echo -e "$@" >&2 || true; }
info()  { echo -e "$@" >&2; }
warn()  { echo -e "${YELLOW}Warning: $*${NC}" >&2; }
die()   {
  # Optional leading numeric argument sets the exit code (defaults to 1).
  local code=1
  [[ "${1:-}" =~ ^[0-9]+$ ]] && { code="$1"; shift; }
  echo -e "${RED}Error: $*${NC}" >&2
  exit "$code"
}

# --- GLOBALS ---
VERBOSE=false
NO_EMS=false
REQUIRE_FREE=false
EMS_BOOKED=false
REFRESH=false
INFO=false
OPEN_LOG=false
DIAG=false
METHOD=""
DEVICE_FILTER=""
ROOM_CODE=""
REMOTE_CMD=()

# Configurable settings — resolved by load_config() from the config file,
# falling back to these built-in defaults. See the CONFIGURATION header.
CONFIG_FILE=""
EXPORT_PATH=""
VLAN_NAME=""
STALE_DAYS=""
SSH_PORT=""
TELNET_PORT=""
PROBE_TIMEOUT=""
PANEL_LABELS=""
PROJECTOR_PREFIX=""
LOG_FILE=""
DIAG_SSH_TYPES=""
DIAG_CMD=""
DIAG_TIMEOUT=""
VC4_TIMEOUT=""
HDPS_TIMEOUT=""

# Set in check_deps: whether TCP port probing is available (needs `timeout`).
PORT_PROBE=false

EXPORT_FILE=""
DEVICE_IPS=()
DEVICE_LABELS=()
DEVICE_STATUSES=()
DIAG_OUTPUTS=()
SELECTED_IP=""
SELECTED_LABEL=""
MULTI=false
SELECTED_IPS=()
SELECTED_LABELS=()

EMS_SCRIPT=""
CONNECT_SCRIPT=""

# --- CONFIG & LOGGING ---

# Write a commented template listing every key and its default, so a first-run
# config is self-documenting and sources to a no-op (defaults still apply).
create_default_config() {
  local cfg="$1" dir
  dir="$(dirname "$cfg")"
  mkdir -p "$dir" 2>/dev/null || { warn "Could not create config dir ${dir} — using defaults"; return; }

  cat > "$cfg" 2>/dev/null <<'EOF' || { warn "Could not write ${cfg} — using defaults"; return; }
# classroom.sh configuration — sourced as shell, so use KEY="value" syntax.
# Every setting below is shown with its built-in default; uncomment to change.

# Path to the SmartClassroom VLAN export.
#EXPORT_PATH="$HOME/work/SmartClassroom"

# VLAN name passed to 'efficient vlan show <name> --no-pager' on --refresh.
#VLAN_NAME="SmartClassroom"

# Age (in days) beyond which the export is warned as stale.
#STALE_DAYS=1

# Ports probed to determine device reachability.
#SSH_PORT=22
#TELNET_PORT=41795

# Per-probe timeout in seconds for the TCP/ICMP reachability checks.
#PROBE_TIMEOUT=1

# Space-separated device labels offered a PanelViewer alternative to SSH.
#PANEL_LABELS="PANEL TSW750"

# Label prefix treated as a web-only projector (opened in a browser).
#PROJECTOR_PREFIX="PROJ"

# Device label prefixes that --diag runs DIAG_CMD against over SSH.
#DIAG_SSH_TYPES="PANEL TSW750 HDPS DMPS"

# Command to run on each matched device (read-only status query).
# "-T" renders the Crestron IP table in tabular form.
#DIAG_CMD="iptable -T"

# Per-device timeout (seconds) for the diagnostic command.
#DIAG_TIMEOUT=15

# Timeout (seconds) for the VC-4 status lookup. Kept separate from
# DIAG_TIMEOUT since room_status.sh's own curl call uses --max-time 30
# internally — this should stay comfortably above that.
#VC4_TIMEOUT=35

# Timeout (seconds) for the HD-PS status snapshot (routing/signal/mute),
# per matched HDPS device. Runs hdps_status.sh, which logs in and does
# three GETs — keep comfortably above a typical login+GET round trip.
#HDPS_TIMEOUT=20

# Activity log location. Defaults under $XDG_STATE_HOME (~/.local/state).
#LOG_FILE="$HOME/.local/state/classroom/classroom.log"
EOF

  info "${CYAN}Wrote default config → ${cfg}${NC}"
}

# Resolve all configurable settings. Precedence: value set in the config file
# (or environment, since the file is sourced) wins; otherwise the built-in
# default is applied. Creates a template on first run.
load_config() {
  CONFIG_FILE="${CLASSROOM_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/classroom/config}"

  if [[ -f "$CONFIG_FILE" ]]; then
    vecho "${CYAN}Loading config: ${CONFIG_FILE}${NC}"
    # shellcheck disable=SC1090
    source "$CONFIG_FILE" || die "Failed to load config file: ${CONFIG_FILE}"
  else
    create_default_config "$CONFIG_FILE"
  fi

  EXPORT_PATH="${EXPORT_PATH:-${HOME}/work/SmartClassroom}"
  VLAN_NAME="${VLAN_NAME:-SmartClassroom}"
  STALE_DAYS="${STALE_DAYS:-1}"
  SSH_PORT="${SSH_PORT:-22}"
  TELNET_PORT="${TELNET_PORT:-41795}"
  PROBE_TIMEOUT="${PROBE_TIMEOUT:-1}"
  PANEL_LABELS="${PANEL_LABELS:-PANEL TSW750}"
  PROJECTOR_PREFIX="${PROJECTOR_PREFIX:-PROJ}"
  LOG_FILE="${LOG_FILE:-${XDG_STATE_HOME:-${HOME}/.local/state}/classroom/classroom.log}"
  DIAG_SSH_TYPES="${DIAG_SSH_TYPES:-PANEL TSW750 HDPS DMPS}"
  DIAG_CMD="${DIAG_CMD:-iptable -T}"
  DIAG_TIMEOUT="${DIAG_TIMEOUT:-15}"
  VC4_TIMEOUT="${VC4_TIMEOUT:-35}"
  HDPS_TIMEOUT="${HDPS_TIMEOUT:-20}"

  # Prepare the log directory once; failures degrade to a no-op in log().
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
}

# Append a timestamped activity line to LOG_FILE. Best-effort: never aborts the
# run (guarded for `set -e`), so a read-only or missing log dir is harmless.
log() {
  local ts
  ts="$(date +%FT%T)"
  printf '%s %s\n' "$ts" "$*" >> "$LOG_FILE" 2>/dev/null || true
}

# --log: open the activity log in the user's editor and exit. Unquoted "$editor"
# is intentional so EDITOR values with flags (e.g. "code --wait") word-split.
open_log() {
  local editor="${VISUAL:-${EDITOR:-vi}}"
  [[ -f "$LOG_FILE" ]] || warn "No log yet at ${LOG_FILE} — opening a new file"
  info "${CYAN}Opening log (${editor}) → ${LOG_FILE}${NC}"
  # shellcheck disable=SC2086
  exec $editor "$LOG_FILE"
}

# --- HELP ---

print_help() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-v|--verbose] [-h|--help] [--no-ems] [--require-free]
                 [--refresh] [--info] [--log] [--device <type>] [--method <method>]
                 <room_code> [-- <command> [args...]]

Connect to a Crestron AV device by room code.

Options:
  -v, --verbose          Show verbose output (passed to ems.sh and connect.sh)
  -h, --help             Show this help message and exit
  --version              Print version and exit
  --no-ems               Skip EMS availability check
  --require-free         Refuse to connect/send a command if EMS reports the room
                         booked (does not affect --info/--diag). Conflicts with --no-ems.
  --refresh              Refresh SmartClassroom export via efficient before searching
  --info                 Show devices + reachability for the room, then exit (no connect)
  --diag                 Reachability + iptable check on panel/HDPS + VC-4/HDPS status, then exit
  --log                  Open the activity log in \$VISUAL/\$EDITOR and exit (no room code)
  --device <type>        Auto-select the device whose type matches (e.g. dmps, panel);
                         skips the selection prompt. Falls back to the menu if ambiguous.
  --method <method>      Only attempt the given connection method (admin|crestron|telnet)
  --                     End of flags; remaining args are passed as a remote command

Arguments:
  <room_code>  Room code to target (e.g. FH0111, AH1301). Case-insensitive.

Files:
  Config:  \${XDG_CONFIG_HOME:-~/.config}/classroom/config  (override: CLASSROOM_CONFIG)
  Log:     \${XDG_STATE_HOME:-~/.local/state}/classroom/classroom.log  (override: LOG_FILE)
  A commented config template is created on first run.

Exit codes:
  Propagates connect.sh exit codes (0/1/64/69/77)
EOF
}

# --- ARGUMENT PARSING ---

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v|--verbose) VERBOSE=true; shift ;;
      -h|--help)    print_help; exit 0 ;;
      --version)    echo "classroom.sh $VERSION"; exit 0 ;;
      --no-ems)     NO_EMS=true; shift ;;
      --require-free) REQUIRE_FREE=true; shift ;;
      --refresh)    REFRESH=true; shift ;;
      --info)       INFO=true; shift ;;
      --diag)       DIAG=true; shift ;;
      --log|--logs) OPEN_LOG=true; shift ;;
      --device)
        shift
        [[ $# -gt 0 ]] || die 64 "--device requires an argument (e.g. dmps, panel, hdps)"
        DEVICE_FILTER="$1"
        shift
        ;;
      --method)
        shift
        [[ $# -gt 0 ]] || die 64 "--method requires an argument (admin|crestron|telnet)"
        case "$1" in
          admin|crestron|telnet) METHOD="$1" ;;
          *) die 64 "Unknown method '$1' — use admin, crestron, or telnet" ;;
        esac
        shift
        ;;
      --) shift; REMOTE_CMD=("$@"); break ;;
      -*) die 64 "Unknown flag: $1" ;;
      *)
        if [[ -z "$ROOM_CODE" ]]; then
          ROOM_CODE="${1^^}"  # normalize to uppercase
          shift
        else
          die 64 "Unexpected argument: $1"
        fi
        ;;
    esac
  done

  if [[ -z "$ROOM_CODE" ]] && ! $REFRESH && ! $OPEN_LOG; then
    echo -e "${RED}Error: No room code provided.${NC}" >&2
    print_help
    exit 64
  fi

  if $NO_EMS && $REQUIRE_FREE; then
    die 64 "--require-free and --no-ems are mutually exclusive"
  fi
}

# --- DEPENDENCY CHECKS ---

# Resolves a co-located helper script by base name, accepting either the
# repo's "<name>.sh" form or an extensionless "<name>" (e.g. as symlinked
# into ~/bin for direct execution). Prints the resolved path and returns 0,
# or returns 1 if neither form is present/executable.
resolve_script() {
  local name="$1"
  if [[ -x "${SCRIPT_DIR}/${name}.sh" ]]; then
    printf '%s\n' "${SCRIPT_DIR}/${name}.sh"
  elif [[ -x "${SCRIPT_DIR}/${name}" ]]; then
    printf '%s\n' "${SCRIPT_DIR}/${name}"
  else
    return 1
  fi
}

check_deps() {
  if [[ -n "$ROOM_CODE" ]]; then
    EMS_SCRIPT="$(resolve_script ems)" \
      || die 69 "ems.sh (or ems) not found or not executable in ${SCRIPT_DIR}"

    CONNECT_SCRIPT="$(resolve_script connect)" \
      || die 69 "connect.sh (or connect) not found or not executable in ${SCRIPT_DIR}"
  fi

  if ! command -v efficient &>/dev/null; then
    if $REFRESH; then
      die 69 "'efficient' not found in PATH — cannot run --refresh"
    else
      warn "efficient not in PATH — --refresh will not be available"
    fi
  fi

  # TCP port probing needs `timeout` to bound the connect() on filtered ports;
  # without it we fall back to ICMP-only reachability.
  if command -v timeout &>/dev/null; then
    PORT_PROBE=true
  fi
}

# --- EXPORT FILE HANDLING ---

find_export_file() {
  [[ -f "$EXPORT_PATH" ]] || return 1
  EXPORT_FILE="$EXPORT_PATH"
  return 0
}

check_file_age() {
  local file="$1"
  local file_date file_epoch today_epoch age_days

  file_date=$(grep -m1 '^# Exported: ' "$file" 2>/dev/null | awk '{print $3}')

  if [[ -n "$file_date" ]]; then
    file_epoch=$(date -d "$file_date" +%s 2>/dev/null \
      || date -j -f '%Y-%m-%d' "$file_date" +%s 2>/dev/null \
      || echo 0)
  else
    # No header — fall back to file mtime
    file_epoch=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0)
  fi

  today_epoch=$(date +%s)
  age_days=$(( (today_epoch - file_epoch) / 86400 ))

  info "${CYAN}Export : $(basename "$file") (${age_days} day(s) old)${NC}"

  if [[ $age_days -gt $STALE_DAYS ]]; then
    warn "Export is ${age_days} day(s) old — run with --refresh to update"
  fi
}

refresh_export() {
  local outfile="$EXPORT_PATH"
  info "${CYAN}Refreshing SmartClassroom export → ${outfile}${NC}"

  local tmpfile
  tmpfile=$(mktemp)

  # --no-pager is required: without it efficient pipes through less, which
  # opens /dev/tty directly and nothing is captured by the file redirect.
  if ! efficient vlan show "$VLAN_NAME" --no-pager > "$tmpfile"; then
    warn "efficient exited non-zero — export may be incomplete"
    if [[ ! -s "$tmpfile" ]]; then
      rm -f "$tmpfile"
      log "REFRESH vlan=${VLAN_NAME} file=${outfile} status=failed"
      die "Refresh failed — no data written"
    fi
  fi

  { echo "# Exported: $(date +%F)"; cat "$tmpfile"; } > "$outfile"
  rm -f "$tmpfile"

  EXPORT_FILE="$outfile"
  log "REFRESH vlan=${VLAN_NAME} file=${outfile} status=ok"
  info "${GREEN}Export refreshed: ${outfile}${NC}"
}

# --- EMS CHECK ---

run_ems_check() {
  local room="$1"
  local ems_rc=0
  local ems_stderr_file
  ems_stderr_file=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '${ems_stderr_file}'" RETURN

  local ems_args=("--room" "$room" "--now")
  $VERBOSE && ems_args+=("-v")

  info "${CYAN}Checking EMS availability for ${room}...${NC}"

  set +e
  # stdout (FREE/BOOKED line) flows to terminal; stderr captured for error detection
  "$EMS_SCRIPT" "${ems_args[@]}" 2>"$ems_stderr_file"
  ems_rc=$?
  set -e

  local ems_stderr
  ems_stderr=$(cat "$ems_stderr_file")

  if [[ $ems_rc -eq 0 ]]; then
    log "QUERY ems room=${room} result=free"
    vecho "${GREEN}Room is free — proceeding.${NC}"
  elif [[ $ems_rc -eq 1 ]]; then
    if echo "$ems_stderr" | grep -q '^ERROR:'; then
      log "QUERY ems room=${room} result=error"
      warn "EMS check failed (${ems_stderr%%$'\n'*}) — skipping availability check"
    else
      # Room is booked; BOOKED line already printed to stdout by ems.sh
      log "QUERY ems room=${room} result=booked"
      EMS_BOOKED=true
      if $REQUIRE_FREE; then
        warn "Room appears to be IN USE"
      else
        warn "Room appears to be IN USE — proceeding anyway"
      fi
    fi
  else
    log "QUERY ems room=${room} result=rc${ems_rc}"
    warn "EMS check exited with code ${ems_rc} — skipping availability check"
    [[ -n "$ems_stderr" ]] && vecho "$ems_stderr"
  fi
}

# --- DEVICE LOOKUP ---

# Derive a device-type label from a hostname: the segment between the first '-'
# and the first '.' (e.g. "AH1301-HDPS.id.siue.edu" -> "HDPS"), uppercased.
# Returns the result in REPLY (avoids a subshell per call). Empty for inputs
# with no '-' such as a bare IP address.
label_from_host() {
  local host="$1" devtype
  if [[ "$host" == *-* ]]; then
    devtype="${host#*-}"
    devtype="${devtype%%.*}"
    REPLY="${devtype^^}"
  else
    REPLY=""
  fi
}

lookup_devices() {
  local file="$1" room="$2"

  DEVICE_IPS=()
  DEVICE_LABELS=()

  # awk emits "ip hostname" for matching lines in a single pass:
  #   NF>=4 skips blank-MAC Reserved-only lines (NF==2)
  #   the "^ROOM-" anchor prevents prefix false-matches
  local ip hostname
  while read -r ip hostname; do
    label_from_host "$hostname"
    DEVICE_IPS+=("$ip")
    DEVICE_LABELS+=("$REPLY")
  done < <(awk -v room="$room" 'NF>=4 && toupper($3) ~ "^"room"-" {print $1, $3}' "$file")

  log "QUERY lookup room=${room} devices=${#DEVICE_IPS[@]}"
}

# --- REACHABILITY PROBE ---

# Returns 0 if a TCP connection to ip:port opens within 1s. `timeout` bounds the
# connect() so filtered ports (which never send RST) don't hang the probe.
check_port() {
  local ip="$1" port="$2"
  timeout "$PROBE_TIMEOUT" bash -c "exec 3<>/dev/tcp/${ip}/${port}" 2>/dev/null
}

# Prints a single reachability status word for one IP:
#   SSH     — port 22 open (connect.sh admin/crestron methods will reach it)
#   TELNET  — port 41795 open (Crestron legacy console reachable)
#   PING    — answers ICMP but no console port open (up but likely wedged)
#   OFFLINE — no response
# Falls back to ONLINE/OFFLINE (ICMP only) when `timeout` is unavailable.
probe_one() {
  local ip="$1"
  if $PORT_PROBE; then
    if check_port "$ip" "$SSH_PORT";    then echo "SSH";    return; fi
    if check_port "$ip" "$TELNET_PORT"; then echo "TELNET"; return; fi
    if ping -c 1 -W "$PROBE_TIMEOUT" "$ip" &>/dev/null; then echo "PING"; else echo "OFFLINE"; fi
  else
    if ping -c 1 -W "$PROBE_TIMEOUT" "$ip" &>/dev/null; then echo "ONLINE"; else echo "OFFLINE"; fi
  fi
}

# Probes all IPs in DEVICE_IPS in parallel; populates DEVICE_STATUSES in order.
probe_devices() {
  DEVICE_STATUSES=()
  local tmpfiles=() pids=() i

  info "${CYAN}Checking device availability...${NC}"

  for (( i=0; i<${#DEVICE_IPS[@]}; i++ )); do
    local tmp
    tmp=$(mktemp)
    tmpfiles+=("$tmp")
    probe_one "${DEVICE_IPS[i]}" > "$tmp" &
    pids+=($!)
  done

  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done

  for tmp in "${tmpfiles[@]}"; do
    DEVICE_STATUSES+=("$(cat "$tmp")")
    rm -f "$tmp"
  done
}

# Prints a green section divider (--diag uses this between its sections;
# the existing cyan divider is reserved for the room-header/EMS framing).
divider() {
  info "${GREEN}----------------------------------------${NC}"
}

# Sets REPLY to the color for a reachability status word.
status_color() {
  case "$1" in
    SSH|TELNET|ONLINE) REPLY="$GREEN" ;;
    PING)              REPLY="$YELLOW" ;;
    *)                 REPLY="$RED" ;;
  esac
}

# Prints one tabular device row to stderr. Args: index, optional line prefix
# (e.g. "  1) "). Uses DEVICE_LABELS/IPS/STATUSES.
print_device_row() {
  local i="$1" prefix="${2:-}"
  local status="${DEVICE_STATUSES[i]}" sc
  status_color "$status"; sc="$REPLY"
  printf "%b%-12s  %-18s  %b%s%b\n" \
    "$prefix" "${DEVICE_LABELS[i]}" "${DEVICE_IPS[i]}" "$sc" "$status" "$NC" >&2
}

# --- INTERACTIVE DEVICE SELECTION ---

handle_not_found() {
  warn "No devices found for room code '${ROOM_CODE}' in $(basename "$EXPORT_FILE")"
  info ""
  info "  ${CYAN}1)${NC} Refresh export and re-search"
  info "  ${CYAN}2)${NC} Enter hostname or IP manually"
  info "  ${CYAN}3)${NC} Abort"
  info ""

  local choice
  read -rp "Choice [1-3]: " choice

  case "$choice" in
    1)
      if ! command -v efficient &>/dev/null; then
        die 69 "efficient not found in PATH — cannot refresh"
      fi
      refresh_export
      lookup_devices "$EXPORT_FILE" "$ROOM_CODE"
      if [[ ${#DEVICE_IPS[@]} -eq 0 ]]; then
        die "Still no devices found for '${ROOM_CODE}' after refresh"
      fi
      select_device
      ;;
    2)
      local manual
      read -rp "Enter hostname or IP: " manual
      [[ -z "$manual" ]] && die "No target entered — aborting"
      # Derive the label so is_panel/is_projector handling still applies to
      # manually-entered hostnames (bare IPs yield an empty label).
      label_from_host "$manual"
      SELECTED_IP="$manual"
      SELECTED_LABEL="$REPLY"
      ;;
    3|"")
      die "Aborted"
      ;;
    *)
      die "Invalid choice — aborting"
      ;;
  esac
}

# Narrows DEVICE_IPS/LABELS to entries matching DEVICE_FILTER (case-insensitive):
# exact type match first, then prefix match. Leaves the arrays untouched (and
# warns) when nothing matches, so selection falls back to the full list.
apply_device_filter() {
  local f="${DEVICE_FILTER^^}" i
  local ips=() labels=()

  for (( i=0; i<${#DEVICE_LABELS[@]}; i++ )); do
    [[ "${DEVICE_LABELS[i]^^}" == "$f" ]] && { ips+=("${DEVICE_IPS[i]}"); labels+=("${DEVICE_LABELS[i]}"); }
  done
  if [[ ${#ips[@]} -eq 0 ]]; then
    for (( i=0; i<${#DEVICE_LABELS[@]}; i++ )); do
      [[ "${DEVICE_LABELS[i]^^}" == "$f"* ]] && { ips+=("${DEVICE_IPS[i]}"); labels+=("${DEVICE_LABELS[i]}"); }
    done
  fi

  if [[ ${#ips[@]} -eq 0 ]]; then
    warn "No '${DEVICE_FILTER}' device in ${ROOM_CODE} — showing all devices"
    return
  fi

  DEVICE_IPS=("${ips[@]}")
  DEVICE_LABELS=("${labels[@]}")
}

# --info: print devices + reachability for the room and return (no connection).
show_info() {
  local count=${#DEVICE_IPS[@]}
  if [[ $count -eq 0 ]]; then
    warn "No devices found for '${ROOM_CODE}' in $(basename "$EXPORT_FILE")"
    return
  fi

  probe_devices
  info ""
  info "${BOLD}${count} device(s) for ${ROOM_CODE}:${NC}"
  local i
  for (( i=0; i<count; i++ )); do
    print_device_row "$i" "  "
  done
}

# --- QUICK DIAGNOSTICS ---

# Strips the trailing device-prompt line (e.g. "TSW-770>") and any blank
# lines at the start/end of raw command output, so it prints tightly like
# the other status sections.
clean_diag_output() {
  local text="$1"
  text=$(sed -E '/^[A-Za-z0-9_.-]+>[[:space:]]*$/d' <<< "$text")
  text=$(sed -e '/./,$!d' <<< "$text")
  text=$(tac <<< "$text" | sed -e '/./,$!d' | tac)
  printf '%s' "$text"
}

# Condenses a raw 'iptable -T' pipe-table into one colorized line per entry
# (CIP id, type, status, port, site/IP, plus model/description only when
# non-empty). Splits on '|' rather than column width, since the device pads
# fields inconsistently. Prints nothing (and lets the caller fall back to
# the raw text) if the input doesn't look like an iptable dump.
condense_iptable() {
  awk -F'|' -v red="$RED" -v green="$GREEN" -v yellow="$YELLOW" -v nc="$NC" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^-+$/ { next }
    /CIP_ID/ { next }
    /^[[:space:]]*IP Table:[[:space:]]*$/ { next }
    NF < 6 { next }
    {
      id = trim($1); type = trim($2); status = trim($3); port = trim($5); site = trim($6);
      model = (NF >= 7) ? trim($7) : "";
      desc  = (NF >= 8) ? trim($8) : "";
      if (id == "") next
      color = nc
      if (status == "ONLINE")       color = green
      else if (status == "OFFLINE") color = red
      else if (status != "")        color = yellow
      line = sprintf("  CIP %-4s %-6s %s%-8s%s port=%-6s %s", id, type, color, status, nc, port, site)
      if (model != "") line = line " [" model "]"
      if (desc  != "") line = line " (" desc ")"
      print line
    }
  '
}

# Runs DIAG_CMD (default 'iptable -T') on each SSH-reachable device whose
# label matches DIAG_SSH_TYPES, in parallel. Populates DIAG_OUTPUTS in
# DEVICE_IPS order (empty string for devices that were skipped).
probe_iptables() {
  DIAG_OUTPUTS=()
  local tmpfiles=() pids=() i t label matches
  local -a diag_cmd
  read -ra diag_cmd <<< "$DIAG_CMD"

  for (( i=0; i<${#DEVICE_IPS[@]}; i++ )); do
    label="${DEVICE_LABELS[i]^^}"
    matches=false
    for t in $DIAG_SSH_TYPES; do
      [[ "$label" == "${t^^}"* ]] && { matches=true; break; }
    done

    if [[ "${DEVICE_STATUSES[i]}" != "SSH" || "$matches" != true ]]; then
      tmpfiles+=("")
      pids+=("")
      continue
    fi

    local f
    f=$(mktemp)
    tmpfiles+=("$f")
    (
      timeout "$DIAG_TIMEOUT" "$CONNECT_SCRIPT" "${DEVICE_IPS[i]}" -- "${diag_cmd[@]}" \
        > "$f" 2>&1 || echo "[diag] command failed or timed out" >> "$f"
    ) &
    pids+=("$!")
  done

  for pid in "${pids[@]}"; do
    [[ -n "$pid" ]] && wait "$pid" 2>/dev/null
  done

  for f in "${tmpfiles[@]}"; do
    if [[ -n "$f" ]]; then
      DIAG_OUTPUTS+=("$(clean_diag_output "$(cat "$f")")")
      rm -f "$f"
    else
      DIAG_OUTPUTS+=("")
    fi
  done
}

# --- VC-4 STATUS ---
# DEPENDENCIES:
#   room_status.sh  — Co-located in the same directory as this script.
#                      Requires curl and jq. Reads crestron/vc4/host,
#                      work/username, and work/password from pass itself
#                      when --server/--web-user/--web-pass aren't passed,
#                      so no credential handling is needed here.
check_vc4_status() {
  local vc4_script
  vc4_script="$(resolve_script room_status)" || {
    warn "room_status.sh (or room_status) not found or not executable in ${SCRIPT_DIR} — skipping VC-4 check"
    return
  }

  info "${BOLD}VC-4 status:${NC}"

  local output rc
  set +e
  output=$(timeout "$VC4_TIMEOUT" "$vc4_script" "$ROOM_CODE" 2>&1)
  rc=$?
  set -e

  case $rc in
    0)
      # awk, not sed: sed's replacement text treats a leading "\0" (which
      # $GREEN/$RED start with, as literal "\033...") as a whole-match
      # backreference, mangling the color codes. awk's gsub has no such trap.
      output=$(awk -v green="$GREEN" -v red="$RED" -v nc="$NC" '
        { gsub(/\<ONLINE\>/, green "&" nc); gsub(/\<OFFLINE\>/, red "&" nc); print }
      ' <<< "$output")
      while IFS= read -r line; do info "  ${line}"; done <<< "$output"
      ;;
    1)
      warn "VC-4: no devices found for room '${ROOM_CODE}'"
      ;;
    2)
      warn "VC-4 check misconfigured (missing server/credentials — check pass entries crestron/vc4/host, work/username, work/password)"
      ;;
    124)
      warn "VC-4 status check timed out after ${VC4_TIMEOUT}s"
      ;;
    *)
      warn "VC-4 status check failed (exit ${rc})"
      vecho "$output"
      ;;
  esac
}

# --- HD-PS STATUS ---
# DEPENDENCIES:
#   hdps_status.sh — Co-located in the same directory as this script.
#                     Requires curl and jq. Reads crestron/creds/username
#                     and crestron/creds/password from pass itself when
#                     credentials aren't overridden, so no credential
#                     handling is needed here.
check_hdps_web() {
  local hdps_script
  hdps_script="$(resolve_script hdps_status)" || {
    warn "hdps_status.sh (or hdps_status) not found or not executable in ${SCRIPT_DIR} — skipping HD-PS status check"
    return
  }

  # Match this script's own color decision (colors disabled -> NC is empty),
  # since hdps_status.sh's stdout is captured below and can't see the TTY.
  local hdps_color="never"
  [[ -n "$NC" ]] && hdps_color="always"

  local i label output rc first=true
  for (( i=0; i<${#DEVICE_LABELS[@]}; i++ )); do
    label="${DEVICE_LABELS[i]^^}"
    [[ "$label" == HDPS* ]] || continue

    $first || info ""
    first=false
    info "${BOLD}${DEVICE_LABELS[i]} status:${NC}"

    set +e
    output=$(timeout "$HDPS_TIMEOUT" "$hdps_script" --color "$hdps_color" "${DEVICE_IPS[i]}" 2>&1)
    rc=$?
    set -e

    case $rc in
      0)
        while IFS= read -r line; do info "  ${line}"; done <<< "$output"
        ;;
      77)
        warn "HD-PS status check misconfigured (missing credentials — check pass entries crestron/creds/username, crestron/creds/password)"
        ;;
      124)
        warn "HD-PS status check timed out after ${HDPS_TIMEOUT}s"
        ;;
      *)
        warn "HD-PS status check failed (exit ${rc})"
        vecho "$output"
        ;;
    esac
  done
}

# --diag: reachability probe + iptable check (SSH-reachable panel/DMPS/HDPS
# only) + VC-4 status + HD-PS routing/signal/mute status snapshot. The VC-4
# and HD-PS sections are skipped entirely when the room has no HDPS device
# (VC-4 lookups return nothing useful, and there's no HD-PS endpoint to hit).
# Read-only; no connection opened.
show_diagnostics() {
  local count=${#DEVICE_IPS[@]}
  if [[ $count -eq 0 ]]; then
    warn "No devices found for '${ROOM_CODE}' in $(basename "$EXPORT_FILE")"
    return
  fi

  probe_devices
  info ""
  info "${BOLD}${count} device(s) for ${ROOM_CODE}:${NC}"
  local i
  for (( i=0; i<count; i++ )); do
    print_device_row "$i" "  "
  done

  info ""
  divider
  info "${CYAN}Running '${DIAG_CMD}' on reachable panel/HDPS devices...${NC}"
  probe_iptables

  local condensed
  for (( i=0; i<count; i++ )); do
    [[ -z "${DIAG_OUTPUTS[i]}" ]] && continue
    info ""
    info "${BOLD}${DEVICE_LABELS[i]} (${DEVICE_IPS[i]}) — ${DIAG_CMD}:${NC}"
    condensed="$(condense_iptable <<< "${DIAG_OUTPUTS[i]}")"
    while IFS= read -r line; do
      info "  ${line}"
    done <<< "${condensed:-${DIAG_OUTPUTS[i]}}"
  done

  local has_hdps=false label
  for (( i=0; i<count; i++ )); do
    label="${DEVICE_LABELS[i]^^}"
    [[ "$label" == HDPS* ]] && { has_hdps=true; break; }
  done

  if $has_hdps; then
    info ""
    divider
    check_vc4_status

    info ""
    divider
    check_hdps_web
  else
    vecho "${CYAN}No HDPS device in ${ROOM_CODE} — skipping VC-4 and HD-PS status checks.${NC}"
  fi

  log "DIAG room=${ROOM_CODE} devices=${count}"
}

select_device() {
  local count=${#DEVICE_IPS[@]}

  if [[ $count -eq 0 ]]; then
    handle_not_found
    return
  fi

  if [[ -n "$DEVICE_FILTER" ]]; then
    apply_device_filter
    count=${#DEVICE_IPS[@]}
  fi

  probe_devices
  info ""

  # --device narrowed to exactly one match: select it without a prompt.
  if [[ -n "$DEVICE_FILTER" && $count -eq 1 ]]; then
    SELECTED_IP="${DEVICE_IPS[0]}"
    SELECTED_LABEL="${DEVICE_LABELS[0]}"
    info "${BOLD}Selected ${DEVICE_LABELS[0]} (matched --device ${DEVICE_FILTER}):${NC}"
    print_device_row 0 "  "
    return
  fi

  if [[ $count -eq 1 ]]; then
    info "${BOLD}Found 1 device:${NC}"
    print_device_row 0 "  "
    local yn
    read -rp "Connect? [Y/n] " yn
    yn="${yn:-Y}"
    if [[ "$yn" =~ ^[Yy] ]]; then
      SELECTED_IP="${DEVICE_IPS[0]}"
      SELECTED_LABEL="${DEVICE_LABELS[0]}"
    else
      die "Aborted"
    fi
    return
  fi

  info "${BOLD}Found ${count} device(s) for ${ROOM_CODE}:${NC}"
  local i
  for (( i=0; i<count; i++ )); do
    print_device_row "$i" "$(printf '  %b%d)%b ' "$CYAN" "$((i+1))" "$NC")"
  done
  info ""

  local raw_choice
  while true; do
    read -rp "Select device(s) [1-${count}] (space/comma-separated, or 'all'): " raw_choice
    raw_choice="${raw_choice//,/ }"

    if [[ "$raw_choice" == "all" ]]; then
      SELECTED_IPS=("${DEVICE_IPS[@]}")
      SELECTED_LABELS=("${DEVICE_LABELS[@]}")
      MULTI=true
      break
    fi

    local indices=() valid=true
    declare -A _seen=()
    for token in $raw_choice; do
      if [[ "$token" =~ ^[0-9]+$ ]] && (( token >= 1 && token <= count )); then
        if [[ -z "${_seen[$token]+x}" ]]; then
          _seen[$token]=1
          indices+=("$token")
        fi
      else
        valid=false
        break
      fi
    done
    unset _seen

    if ! $valid || [[ ${#indices[@]} -eq 0 ]]; then
      warn "Enter number(s) between 1 and ${count}, separated by spaces or commas"
      continue
    fi

    if [[ ${#indices[@]} -eq 1 ]]; then
      SELECTED_IP="${DEVICE_IPS[$((${indices[0]}-1))]}"
      SELECTED_LABEL="${DEVICE_LABELS[$((${indices[0]}-1))]}"
    else
      for token in "${indices[@]}"; do
        SELECTED_IPS+=("${DEVICE_IPS[$((token-1))]}")
        SELECTED_LABELS+=("${DEVICE_LABELS[$((token-1))]}")
      done
      MULTI=true
    fi
    break
  done
}

# --- PANEL VIEWER ---

is_panel() {
  local lbl="${SELECTED_LABEL^^}" p
  for p in $PANEL_LABELS; do
    [[ "$lbl" == "${p^^}" ]] && return 0
  done
  return 1
}

# --- PROJECTOR ---

is_projector() {
  local prefix="${PROJECTOR_PREFIX^^}"
  [[ -n "$prefix" && "${SELECTED_LABEL^^}" == "$prefix"* ]]
}

# Projectors have no SSH access — always open the web interface.
maybe_open_projector() {
  is_projector || return 0

  local url="http://${SELECTED_IP}"
  info ""
  info "${CYAN}----------------------------------------${NC}"
  info "${CYAN}Opening ${url} for ${ROOM_CODE}${NC}"
  info "${CYAN}----------------------------------------${NC}"
  log "CONNECT room=${ROOM_CODE} target=${SELECTED_IP} label=${SELECTED_LABEL:-?} method=web url=${url}"
  xdg-open "$url"
  exit 0
}

# Offered when a PANEL/TSW750 is selected and panelviewer is in PATH.
# Skipped silently if a remote command or --method was specified (SSH intent).
maybe_open_viewer() {
  # Unambiguous SSH intent — skip prompt
  [[ ${#REMOTE_CMD[@]} -gt 0 || -n "$METHOD" ]] && return 0
  is_panel || return 0

  if ! command -v panelviewer &>/dev/null; then
    warn "panelviewer not in PATH — connecting via SSH (install panelviewer to enable viewer mode)"
    return
  fi

  info ""
  info "  ${CYAN}1)${NC} SSH shell"
  info "  ${CYAN}2)${NC} Panel Viewer (GUI)"
  info ""

  local choice
  read -rp "How would you like to connect? [1/2]: " choice

  case "${choice:-1}" in
    1) return ;;  # fall through to do_connect
    2)
      info ""
      info "${CYAN}----------------------------------------${NC}"
      info "${CYAN}Opening viewer for ${ROOM_CODE} → ${SELECTED_IP}${NC}"
      info "${CYAN}----------------------------------------${NC}"
      log "CONNECT room=${ROOM_CODE} target=${SELECTED_IP} label=${SELECTED_LABEL:-?} method=viewer"
      exec panelviewer "$SELECTED_IP"
      ;;
    *) warn "Invalid choice — defaulting to SSH" ;;
  esac
}

# --- CONNECTION ---

do_connect() {
  local target="$1"

  info ""
  info "${CYAN}----------------------------------------${NC}"
  info "${CYAN}Connecting to ${ROOM_CODE} → ${target}${NC}"
  info "${CYAN}----------------------------------------${NC}"

  local connect_args=()
  $VERBOSE             && connect_args+=("-v")
  [[ -n "$METHOD" ]]   && connect_args+=("--method" "$METHOD")
  connect_args+=("$target")
  if [[ ${#REMOTE_CMD[@]} -gt 0 ]]; then
    connect_args+=("--" "${REMOTE_CMD[@]}")
  fi

  log "CONNECT room=${ROOM_CODE} target=${target} label=${SELECTED_LABEL:-?} method=${METHOD:-auto}${REMOTE_CMD:+ cmd=${REMOTE_CMD[*]}}"
  exec "$CONNECT_SCRIPT" "${connect_args[@]}"
}

# --- MULTI-DEVICE TMUX ---

build_connect_cmd() {
  local ip="$1"
  local parts=("$CONNECT_SCRIPT")
  $VERBOSE           && parts+=("-v")
  [[ -n "$METHOD" ]] && parts+=("--method" "$METHOD")
  parts+=("$ip")
  [[ ${#REMOTE_CMD[@]} -gt 0 ]] && parts+=("--" "${REMOTE_CMD[@]}")
  printf '%q ' "${parts[@]}"
}

open_tmux_session() {
  if ! command -v tmux &>/dev/null; then
    echo -e "${RED}Error: tmux not found in PATH — required for multi-device mode${NC}" >&2
    exit 69
  fi

  # Projectors have no SSH; skip them in multi mode
  local ssh_ips=() ssh_labels=() i
  for (( i=0; i<${#SELECTED_IPS[@]}; i++ )); do
    case "${SELECTED_LABELS[i]^^}" in
      PROJ*)
        warn "Skipping ${SELECTED_LABELS[i]} (${SELECTED_IPS[i]}) — projectors have no SSH"
        ;;
      *)
        ssh_ips+=("${SELECTED_IPS[i]}")
        ssh_labels+=("${SELECTED_LABELS[i]}")
        ;;
    esac
  done

  if [[ ${#ssh_ips[@]} -eq 0 ]]; then
    die "No SSH-capable devices selected after filtering projectors"
  fi

  # After filtering we may be back to one device — use the normal path
  if [[ ${#ssh_ips[@]} -eq 1 ]]; then
    SELECTED_IP="${ssh_ips[0]}"
    SELECTED_LABEL="${ssh_labels[0]}"
    do_connect "$SELECTED_IP"
    return
  fi

  local session="cls-${ROOM_CODE,,}"
  local win="$ROOM_CODE"
  local first_cmd target ci

  first_cmd=$(build_connect_cmd "${ssh_ips[0]}")

  if [[ -n "${TMUX:-}" ]]; then
    tmux new-window -n "$win" "$first_cmd"
    target="$win"
  else
    tmux new-session -d -s "$session" -n "$win" "$first_cmd"
    target="$session"
  fi

  tmux set-option -t "$target" remain-on-exit on
  tmux set-option -t "$target" pane-border-status top
  tmux select-pane -t "$target" -T "${ssh_labels[0]} ${ssh_ips[0]}"

  for (( i=1; i<${#ssh_ips[@]}; i++ )); do
    ci=$(build_connect_cmd "${ssh_ips[i]}")
    tmux split-window -t "$target" "$ci"
    tmux select-pane -t "$target" -T "${ssh_labels[i]} ${ssh_ips[i]}"
    tmux select-layout -t "$target" tiled
  done

  info ""
  info "${CYAN}Opened ${#ssh_ips[@]} panes in tmux session '${session}'.${NC}"
  info "${CYAN}Close dead panes with: prefix + x${NC}"

  [[ -z "${TMUX:-}" ]] && exec tmux attach -t "$session"
}

# --- MAIN ---

main() {
  parse_args "$@"
  load_config
  $OPEN_LOG && open_log
  check_deps

  if $REFRESH; then
    refresh_export
    [[ -z "$ROOM_CODE" ]] && exit 0
  elif ! find_export_file; then
    warn "No SmartClassroom export found at ${EXPORT_PATH}"
    if command -v efficient &>/dev/null; then
      local yn
      read -rp "Fetch now with efficient? [Y/n] " yn
      yn="${yn:-Y}"
      if [[ "$yn" =~ ^[Yy] ]]; then
        refresh_export
      else
        die "No export file — cannot continue"
      fi
    else
      die 69 "No export file found and efficient not in PATH — run: efficient vlan show ${VLAN_NAME} --no-pager > ${EXPORT_PATH}"
    fi
  fi

  check_file_age "$EXPORT_FILE"

  info "${CYAN}Room   : ${ROOM_CODE}${NC}"
  info "${CYAN}----------------------------------------${NC}"

  $NO_EMS || run_ems_check "$ROOM_CODE"

  info ""
  info "${CYAN}Looking up devices...${NC}"
  lookup_devices "$EXPORT_FILE" "$ROOM_CODE"

  if $INFO; then
    show_info
    exit 0
  fi

  if $DIAG; then
    show_diagnostics
    exit 0
  fi

  if $REQUIRE_FREE && $EMS_BOOKED; then
    log "CONNECT room=${ROOM_CODE} result=blocked reason=ems_booked"
    die "Room ${ROOM_CODE} is in use (EMS) — refusing to connect (--require-free)"
  fi

  select_device
  if $MULTI; then
    open_tmux_session
  else
    maybe_open_viewer
    maybe_open_projector
    do_connect "$SELECTED_IP"
  fi
}

main "$@"
