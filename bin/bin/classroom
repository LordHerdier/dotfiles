#!/bin/bash
# =============================================================================
# classroom.sh — Classroom Device Connection Utility
# =============================================================================
#
# DESCRIPTION:
#   Wraps the EMS availability check, SmartClassroom VLAN device lookup, and
#   Crestron device connection into a single command. Typical usage:
#
#     1. Checks EMS to see if the target room is currently in use.
#     2. Looks up AV devices for that room (HDPS, PANEL, DMPS, etc.) in the
#        local SmartClassroom VLAN export file.
#     3. Prompts you to select a device if multiple are found, then hands off
#        to connect.
#
# USAGE:
#   classroom.sh [-v|--verbose] [-h|--help] [--no-ems] [--refresh]
#                [--method <method>] <room_code> [-- <command> [args...]]
#
#   <room_code>
#       Room code to connect to (e.g. "FH0111", "AH1301"). Case-insensitive.
#       Matched against device hostnames in the SmartClassroom export.
#
#   -v, --verbose
#       Show verbose output; passed through to ems and connect.
#
#   -h, --help
#       Print this usage summary and exit.
#
#   --no-ems
#       Skip the EMS availability check entirely.
#
#   --refresh
#       Force-refresh the SmartClassroom export before searching by running
#       'efficient vlan show SmartClassroom --no-pager'. Requires efficient
#       to be in PATH.
#
#   --method <admin|crestron|telnet>
#       Passed through to connect — skip the cascade and use only this
#       connection method.
#
#   -- <command> [args...]
#       Passed through to connect — run a command instead of an
#       interactive session.
#
# EXAMPLES:
#   classroom.sh FH0111                  # Check EMS, find devices, connect
#   classroom.sh --no-ems AH1301         # Skip EMS check
#   classroom.sh --refresh FH0111        # Refresh export, then connect
#   classroom.sh FH0111 -- ver           # Run 'ver' on the selected device
#   classroom.sh --method telnet PH0302  # Force telnet connection
#
# DEPENDENCIES:
#   ems       — Co-located in the same directory as this script.
#   connect   — Co-located in the same directory as this script.
#   efficient    — Only required when --refresh is used. Must be in PATH.
#                  Run: efficient vlan show SmartClassroom --no-pager
#   panelviewer  — Optional. Must be in PATH. When present, offered as an
#                  alternative to SSH for PANEL/TSW750 devices.
#
# SMART CLASSROOM EXPORT:
#   Auto-detected from ~/work/SmartClassroom.YYYY-MM-DD (most recent file
#   used). To refresh: classroom.sh --refresh, or manually:
#     efficient vlan show SmartClassroom --no-pager > ~/work/SmartClassroom.$(date +%F)
#
# EXIT CODES:
#   Propagates connect exit codes via exec:
#   0   Session established and ended cleanly.
#   1   Connection failed or user aborted.
#   64  Usage error.
#   69  Missing required dependency.
#   77  Credential retrieval failure.
#
# =============================================================================

set -euo pipefail

readonly VERSION="1.1"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly WORK_DIR="${HOME}/work"

# --- COLORS (disabled when stderr is not a TTY) ---
if [[ -t 2 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' NC=''
fi

vecho() { $VERBOSE && echo -e "$@" >&2 || true; }
info() { echo -e "$@" >&2; }
warn() { echo -e "${YELLOW}Warning: $*${NC}" >&2; }
die() {
  echo -e "${RED}Error: $*${NC}" >&2
  exit 1
}

# --- GLOBALS ---
VERBOSE=false
NO_EMS=false
REFRESH=false
METHOD=""
ROOM_CODE=""
REMOTE_CMD=()

EXPORT_FILE=""
DEVICE_IPS=()
DEVICE_LABELS=()
SELECTED_IP=""
SELECTED_LABEL=""

# --- HELP ---

print_help() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-v|--verbose] [-h|--help] [--no-ems] [--refresh]
                 [--method <method>] <room_code> [-- <command> [args...]]

Connect to a Crestron AV device by room code.

Options:
  -v, --verbose          Show verbose output (passed to ems and connect)
  -h, --help             Show this help message and exit
  --version              Print version and exit
  --no-ems               Skip EMS availability check
  --refresh              Refresh SmartClassroom export via efficient before searching
  --method <method>      Only attempt the given connection method (admin|crestron|telnet)
  --                     End of flags; remaining args are passed as a remote command

Arguments:
  <room_code>  Room code to target (e.g. FH0111, AH1301). Case-insensitive.

Exit codes:
  Propagates connect exit codes (0/1/64/69/77)
EOF
}

# --- ARGUMENT PARSING ---

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      print_help
      exit 0
      ;;
    --version)
      echo "classroom.sh $VERSION"
      exit 0
      ;;
    --no-ems)
      NO_EMS=true
      shift
      ;;
    --refresh)
      REFRESH=true
      shift
      ;;
    --method)
      shift
      if [[ $# -eq 0 ]]; then
        echo -e "${RED}Error: --method requires an argument (admin|crestron|telnet)${NC}" >&2
        exit 64
      fi
      case "$1" in
      admin | crestron | telnet) METHOD="$1" ;;
      *)
        echo -e "${RED}Error: Unknown method '$1' — use admin, crestron, or telnet${NC}" >&2
        exit 64
        ;;
      esac
      shift
      ;;
    --)
      shift
      REMOTE_CMD=("$@")
      break
      ;;
    -*)
      echo -e "${RED}Error: Unknown flag: $1${NC}" >&2
      exit 64
      ;;
    *)
      if [[ -z "$ROOM_CODE" ]]; then
        ROOM_CODE="${1^^}" # normalize to uppercase
        shift
      else
        echo -e "${RED}Error: Unexpected argument: $1${NC}" >&2
        exit 64
      fi
      ;;
    esac
  done

  if [[ -z "$ROOM_CODE" ]]; then
    echo -e "${RED}Error: No room code provided.${NC}" >&2
    print_help
    exit 64
  fi
}

# --- DEPENDENCY CHECKS ---

check_deps() {
  [[ -x "${SCRIPT_DIR}/ems" ]] || die "ems not found or not executable in ${SCRIPT_DIR}"
  [[ -x "${SCRIPT_DIR}/connect" ]] || die "connect not found or not executable in ${SCRIPT_DIR}"

  if ! command -v efficient &>/dev/null; then
    if $REFRESH; then
      echo -e "${RED}Error: 'efficient' not found in PATH — cannot run --refresh${NC}" >&2
      exit 69
    else
      warn "efficient not in PATH — --refresh will not be available"
    fi
  fi
}

# --- EXPORT FILE HANDLING ---

find_export_file() {
  local candidates=()
  # shellcheck disable=SC2206
  candidates=($(ls "${WORK_DIR}"/SmartClassroom.????-??-?? 2>/dev/null | sort))
  if [[ ${#candidates[@]} -eq 0 ]]; then
    return 1
  fi
  EXPORT_FILE="${candidates[-1]}"
  return 0
}

check_file_age() {
  local file="$1"
  local file_date="${file##*.}"
  local file_epoch today_epoch age_days

  file_epoch=$(date -d "$file_date" +%s 2>/dev/null ||
    date -j -f '%Y-%m-%d' "$file_date" +%s 2>/dev/null ||
    echo 0)
  today_epoch=$(date +%s)
  age_days=$(((today_epoch - file_epoch) / 86400))

  info "${CYAN}Export : $(basename "$file") (${age_days} day(s) old)${NC}"

  if [[ $age_days -gt 1 ]]; then
    warn "Export is ${age_days} day(s) old — run with --refresh to update"
  fi
}

refresh_export() {
  local outfile="${WORK_DIR}/SmartClassroom.$(date +%F)"
  info "${CYAN}Refreshing SmartClassroom export → ${outfile}${NC}"

  # --no-pager is required: without it efficient pipes through less, which
  # opens /dev/tty directly and nothing is captured by the file redirect.
  if ! efficient vlan show SmartClassroom --no-pager >"$outfile"; then
    warn "efficient exited non-zero — export may be incomplete"
    if [[ ! -s "$outfile" ]]; then
      rm -f "$outfile"
      die "Refresh failed — no data written"
    fi
  fi

  EXPORT_FILE="$outfile"
  info "${GREEN}Export refreshed: ${outfile}${NC}"
}

# --- EMS CHECK ---

run_ems_check() {
  local room="$1"
  local ems_rc=0
  local ems_stderr_file
  ems_stderr_file=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '${ems_stderr_file}'" RETURN

  local ems_args=("--room" "$room" "--now")
  $VERBOSE && ems_args+=("-v")

  info "${CYAN}Checking EMS availability for ${room}...${NC}"

  set +e
  # stdout (FREE/BOOKED line) flows to terminal; stderr captured for error detection
  "${SCRIPT_DIR}/ems" "${ems_args[@]}" 2>"$ems_stderr_file"
  ems_rc=$?
  set -e

  local ems_stderr
  ems_stderr=$(cat "$ems_stderr_file")

  if [[ $ems_rc -eq 0 ]]; then
    vecho "${GREEN}Room is free — proceeding.${NC}"
  elif [[ $ems_rc -eq 1 ]]; then
    if echo "$ems_stderr" | grep -q '^ERROR:'; then
      warn "EMS check failed (${ems_stderr%%$'\n'*}) — skipping availability check"
    else
      # Room is booked; BOOKED line already printed to stdout by ems
      warn "Room appears to be IN USE — proceeding anyway"
    fi
  else
    warn "EMS check exited with code ${ems_rc} — skipping availability check"
    [[ -n "$ems_stderr" ]] && vecho "$ems_stderr"
  fi
}

# --- DEVICE LOOKUP ---

lookup_devices() {
  local file="$1" room="$2"

  DEVICE_IPS=()
  DEVICE_LABELS=()

  # NF>=4 skips blank-MAC Reserved-only lines (NF==2)
  # Anchor match on "^ROOM-" to prevent prefix false-matches
  while IFS= read -r line; do
    local ip hostname devtype
    ip=$(awk '{print $1}' <<<"$line")
    hostname=$(awk '{print $3}' <<<"$line")

    # Extract device type between first '-' and first '.' in hostname field
    devtype="${hostname#*-}"
    devtype="${devtype%%.*}"
    devtype="${devtype^^}"

    DEVICE_IPS+=("$ip")
    DEVICE_LABELS+=("$devtype")
  done < <(awk -v room="$room" 'NF>=4 && toupper($3) ~ "^"room"-"' "$file")
}

# --- INTERACTIVE DEVICE SELECTION ---

handle_not_found() {
  warn "No devices found for room code '${ROOM_CODE}' in $(basename "$EXPORT_FILE")"
  info ""
  info "  ${CYAN}1)${NC} Refresh export and re-search"
  info "  ${CYAN}2)${NC} Enter hostname or IP manually"
  info "  ${CYAN}3)${NC} Abort"
  info ""

  local choice
  read -rp "Choice [1-3]: " choice

  case "$choice" in
  1)
    if ! command -v efficient &>/dev/null; then
      die "efficient not found in PATH — cannot refresh"
    fi
    refresh_export
    lookup_devices "$EXPORT_FILE" "$ROOM_CODE"
    if [[ ${#DEVICE_IPS[@]} -eq 0 ]]; then
      die "Still no devices found for '${ROOM_CODE}' after refresh"
    fi
    select_device
    ;;
  2)
    local manual
    read -rp "Enter hostname or IP: " manual
    [[ -z "$manual" ]] && die "No target entered — aborting"
    SELECTED_IP="$manual"
    ;;
  3 | "")
    die "Aborted"
    ;;
  *)
    die "Invalid choice — aborting"
    ;;
  esac
}

select_device() {
  local count=${#DEVICE_IPS[@]}

  if [[ $count -eq 0 ]]; then
    handle_not_found
    return
  fi

  info ""

  if [[ $count -eq 1 ]]; then
    info "${BOLD}Found 1 device: ${DEVICE_LABELS[0]}  (${DEVICE_IPS[0]})${NC}"
    local yn
    read -rp "Connect? [Y/n] " yn
    yn="${yn:-Y}"
    if [[ "$yn" =~ ^[Yy] ]]; then
      SELECTED_IP="${DEVICE_IPS[0]}"
      SELECTED_LABEL="${DEVICE_LABELS[0]}"
    else
      die "Aborted"
    fi
    return
  fi

  info "${BOLD}Found ${count} device(s) for ${ROOM_CODE}:${NC}"
  local i
  for ((i = 0; i < count; i++)); do
    printf "  ${CYAN}%d)${NC} %-12s  %s\n" "$((i + 1))" "${DEVICE_LABELS[i]}" "${DEVICE_IPS[i]}" >&2
  done
  info ""

  local choice
  while true; do
    read -rp "Select device [1-${count}]: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)); then
      SELECTED_IP="${DEVICE_IPS[$((choice - 1))]}"
      SELECTED_LABEL="${DEVICE_LABELS[$((choice - 1))]}"
      break
    fi
    warn "Enter a number between 1 and ${count}"
  done
}

# --- PANEL VIEWER ---

is_panel() {
  case "${SELECTED_LABEL^^}" in
  PANEL | TSW750) return 0 ;;
  *) return 1 ;;
  esac
}

# Offered when a PANEL/TSW750 is selected and panelviewer is in PATH.
# Skipped silently if a remote command or --method was specified (SSH intent).
maybe_open_viewer() {
  # Unambiguous SSH intent — skip prompt
  [[ ${#REMOTE_CMD[@]} -gt 0 || -n "$METHOD" ]] && return
  is_panel || return

  if ! command -v panelviewer &>/dev/null; then
    warn "panelviewer not in PATH — connecting via SSH (install panelviewer to enable viewer mode)"
    return
  fi

  info ""
  info "  ${CYAN}1)${NC} SSH shell"
  info "  ${CYAN}2)${NC} Panel Viewer (GUI)"
  info ""

  local choice
  read -rp "How would you like to connect? [1/2]: " choice

  case "${choice:-1}" in
  1) return ;; # fall through to do_connect
  2)
    info ""
    info "${CYAN}----------------------------------------${NC}"
    info "${CYAN}Opening viewer for ${ROOM_CODE} → ${SELECTED_IP}${NC}"
    info "${CYAN}----------------------------------------${NC}"
    exec panelviewer "$SELECTED_IP"
    ;;
  *) warn "Invalid choice — defaulting to SSH" ;;
  esac
}

# --- CONNECTION ---

do_connect() {
  local target="$1"

  info ""
  info "${CYAN}----------------------------------------${NC}"
  info "${CYAN}Connecting to ${ROOM_CODE} → ${target}${NC}"
  info "${CYAN}----------------------------------------${NC}"

  local connect_args=()
  $VERBOSE && connect_args+=("-v")
  [[ -n "$METHOD" ]] && connect_args+=("--method" "$METHOD")
  connect_args+=("$target")
  if [[ ${#REMOTE_CMD[@]} -gt 0 ]]; then
    connect_args+=("--" "${REMOTE_CMD[@]}")
  fi

  exec "${SCRIPT_DIR}/connect" "${connect_args[@]}"
}

# --- MAIN ---

main() {
  parse_args "$@"
  check_deps

  if $REFRESH; then
    refresh_export
  elif ! find_export_file; then
    warn "No SmartClassroom export found in ${WORK_DIR}"
    if command -v efficient &>/dev/null; then
      local yn
      read -rp "Fetch now with efficient? [Y/n] " yn
      yn="${yn:-Y}"
      if [[ "$yn" =~ ^[Yy] ]]; then
        refresh_export
      else
        die "No export file — cannot continue"
      fi
    else
      die "No export file found and efficient not in PATH — run: efficient vlan show SmartClassroom --no-pager > ${WORK_DIR}/SmartClassroom.\$(date +%F)"
    fi
  fi

  check_file_age "$EXPORT_FILE"

  info "${CYAN}Room   : ${ROOM_CODE}${NC}"
  info "${CYAN}----------------------------------------${NC}"

  $NO_EMS || run_ems_check "$ROOM_CODE"

  info ""
  info "${CYAN}Looking up devices...${NC}"
  lookup_devices "$EXPORT_FILE" "$ROOM_CODE"

  select_device
  maybe_open_viewer
  do_connect "$SELECTED_IP"
}

main "$@"
